# The image is built from the workspace manifests, the server, the release and plugin API
# crates, the UI sources and the guide pages the UI ships as help; everything else stays out of
# the build context.
*
!Cargo.toml
!Cargo.lock
!server/
!release/
!plugin-api/
!ui/
!docs/
docs/*
!docs/guide/

**/target/
**/node_modules/
ui/dist/
ui/e2e/.output/
ui/test-results/
ui/playwright-report/
ui/public/third-party-licenses.json
ui/public/THIRD-PARTY-NOTICES.txt
**/*.db
**/*.db-shm
**/*.db-wal
**/.env
**/.env.*
