    { "name": "link with an encoded backslash", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "/%5Cevil.example" }, "code": "panel.field_invalid" },
    { "name": "link with dots in a query", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "/d/abc?next=../x" }, "code": null },
    { "name": "link to a page that starts like the API", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "/apis/x" }, "code": null },
