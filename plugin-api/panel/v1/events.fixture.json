    { "name": "link with a user name", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "https://kalzit.dev@evil.example/" }, "code": "panel.field_invalid" },
    { "name": "link without a host", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "https:///x" }, "code": "panel.field_invalid" },
    { "name": "link with a space", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "https://example.com/a b" }, "code": "panel.field_invalid" },
    { "name": "link to the API", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "/api/auth/logout" }, "code": "panel.field_invalid" },
    { "name": "link to the API in other case", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "/API?x=1" }, "code": "panel.field_invalid" },
