    { "name": "link to javascript", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "javascript:alert(1)" }, "code": "panel.field_invalid" },
    { "name": "link to data", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "data:text/html,x" }, "code": "panel.field_invalid" },
