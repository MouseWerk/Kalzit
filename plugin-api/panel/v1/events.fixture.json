{
  "about": "Events of the panel message API, version 1, with what Kalzit makes of them: `code` is null for an event that passes, else the refusal code. `raw` is sent as the text itself. Checked by kalzit_plugin_api::panel (Rust) and ui/src/features/plugins/panel/protocol.ts (TypeScript), so both sides agree.",
  "cases": [
    { "name": "ready", "event": { "kalzit": "panel", "api": 1, "type": "ready" }, "code": null },
    {
      "name": "click on a row, unknown fields dropped",
      "event": { "kalzit": "panel", "api": 1, "type": "click", "refId": "A", "target": "row", "index": 3, "secret": "x" },
      "code": null,
      "passed": { "kalzit": "panel", "api": 1, "type": "click", "refId": "A", "target": "row", "index": 3 }
    },
    { "name": "click on a node", "event": { "kalzit": "panel", "api": 1, "type": "click", "refId": "A", "target": "node", "id": "n1" }, "code": null },
    { "name": "select", "event": { "kalzit": "panel", "api": 1, "type": "select", "refId": "A", "rows": [0, 2] }, "code": null },
    { "name": "range", "event": { "kalzit": "panel", "api": 1, "type": "range", "from": 1, "to": 2 }, "code": null },
    { "name": "setVariable, one value", "event": { "kalzit": "panel", "api": 1, "type": "setVariable", "name": "host", "value": "a" }, "code": null },
    { "name": "setVariable, many values", "event": { "kalzit": "panel", "api": 1, "type": "setVariable", "name": "host", "value": ["a", "b"] }, "code": null },
    { "name": "resize", "event": { "kalzit": "panel", "api": 1, "type": "resize", "height": 300 }, "code": null },
    { "name": "resize, smallest", "event": { "kalzit": "panel", "api": 1, "type": "resize", "height": 16 }, "code": null },
    { "name": "setOptions", "event": { "kalzit": "panel", "api": 1, "type": "setOptions", "options": { "field": "cpu" } }, "code": null },
    { "name": "link, https", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "https://example.com/runbook?id=4#top", "title": "Runbook" }, "code": null },
    { "name": "link, path in Kalzit", "event": { "kalzit": "panel", "api": 1, "type": "link", "url": "/dashboards/abc?var-host=a" }, "code": null },
    { "name": "log", "event": { "kalzit": "panel", "api": 1, "type": "log", "level": "warn", "text": "no number field" }, "code": null },

    { "name": "not JSON", "raw": "x", "code": "panel.not_json" },
    { "name": "not an object", "event": [1, 2], "code": "panel.not_envelope" },
    { "name": "no envelope", "event": { "api": 1, "type": "ready" }, "code": "panel.not_envelope" },
    { "name": "another API version", "event": { "kalzit": "panel", "api": 2, "type": "ready" }, "code": "panel.api_unsupported" },
    { "name": "an unknown type", "event": { "kalzit": "panel", "api": 1, "type": "runQuery" }, "code": "panel.type_unknown" },
    { "name": "too large", "raw": "TOO_LARGE", "code": "panel.too_large" },
    { "name": "click on a cell", "event": { "kalzit": "panel", "api": 1, "type": "click", "refId": "A", "target": "cell", "index": 1 }, "code": "panel.field_invalid" },
    { "name": "click without index", "event": { "kalzit": "panel", "api": 1, "type": "click", "refId": "A", "target": "row" }, "code": "panel.field_invalid" },
    { "name": "click with an empty refId", "event": { "kalzit": "panel", "api": 1, "type": "click", "refId": "", "target": "row", "index": 1 }, "code": "panel.field_invalid" },
    { "name": "select of a negative row", "event": { "kalzit": "panel", "api": 1, "type": "select", "refId": "A", "rows": [-1] }, "code": "panel.field_invalid" },
    { "name": "range from equals to", "event": { "kalzit": "panel", "api": 1, "type": "range", "from": 5, "to": 5 }, "code": "panel.field_invalid" },
    { "name": "setVariable of a bad name", "event": { "kalzit": "panel", "api": 1, "type": "setVariable", "name": "1x", "value": "a" }, "code": "panel.field_invalid" },
    { "name": "setVariable of an object", "event": { "kalzit": "panel", "api": 1, "type": "setVariable", "name": "x", "value": { "a": 1 } }, "code": "panel.field_invalid" },
    { "name": "setVariable with a control character", "event": { "kalzit": "panel", "api": 1, "type": "setVariable", "name": "x", "value": "a\u0000" }, "code": "panel.field_invalid" },
