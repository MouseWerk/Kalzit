{
  "__inputs": [
    { "name": "DS_LAGER", "label": "Lager", "type": "datasource", "pluginId": "sqlite" }
  ],
  "title": "Lager im Blick",
  "uid": "lager-im-blick",
  "schemaVersion": 39,
  "tags": ["lager", "Lager", "betrieb"],
  "timezone": "Europe/Berlin",
  "weekStart": "monday",
  "refresh": "1m",
  "graphTooltip": 1,
  "time": { "from": "now-24h", "to": "now" },
  "timepicker": { "refresh_intervals": ["10s", "1m", "5m", "1s", "1m"], "nowDelay": "1m" },
  "templating": {
    "list": [
      { "name": "host", "type": "custom", "query": "alpha,beta,Gamma : gamma", "multi": true, "includeAll": true,
        "allValue": "%", "current": { "text": "All", "value": ["$__all"] } },
      { "name": "hosts_from_db", "type": "query", "datasource": { "type": "sqlite", "uid": "${DS_LAGER}" },
        "query": "SELECT DISTINCT host FROM m", "regex": "/a.*/", "sort": 5, "refresh": 2 },
      { "name": "filter", "type": "adhoc", "datasource": { "type": "prometheus", "uid": "prom" } },
      { "name": "step", "type": "interval", "query": "1m,10m,1h", "auto": true },
      { "name": "site", "type": "constant", "query": "werk-1" },
      { "name": "bad-name", "type": "textbox", "query": "x" }
    ]
  },
  "annotations": {
    "list": [
      { "builtIn": 1, "name": "Annotations & Alerts", "datasource": { "type": "grafana", "uid": "-- Grafana --" }, "enable": true },
      { "name": "Lieferungen", "datasource": { "type": "sqlite", "uid": "${DS_LAGER}" }, "enable": false,
        "rawQuery": "SELECT t AS time, 'Lieferung' AS text FROM lieferungen WHERE $__timeFilter(t)" }
    ]
  },
  "links": [
    { "type": "dashboards", "title": "Mehr", "tags": ["lager", "werk"], "targetBlank": true },
    { "type": "link", "title": "Handbuch", "url": "https://example.com/handbuch" },
    { "type": "link", "title": "Gefahr", "url": "javascript:alert(1)" }
  ],
  "panels": [
    { "id": 1, "type": "stat", "title": "Bestand", "gridPos": { "x": 0, "y": 0, "w": 6, "h": 4 },
      "datasource": { "type": "sqlite", "uid": "${DS_LAGER}" },
      "targets": [{ "refId": "A", "rawSql": "SELECT host, v FROM m WHERE host IN ($host)", "format": "table" }],
      "options": { "reduceOptions": { "calcs": ["lastNotNull"] }, "colorMode": "background", "graphMode": "none" },
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1,
        "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 80, "color": "red" } ] } },
        "overrides": [] } },
    { "id": 2, "type": "graph", "title": "Verlauf", "gridPos": { "x": 6, "y": 0, "w": 18, "h": 8 },
      "datasource": { "type": "sqlite", "uid": "${DS_LAGER}" },
      "targets": [{ "refId": "A", "rawSql": "SELECT t, v FROM m WHERE $__timeFilter(t) AND t < $__timeTo()", "format": "time_series" }] },
    { "id": 3, "type": "geomap", "title": "Standorte", "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "sqlite", "uid": "${DS_LAGER}" }, "targets": [{ "refId": "A", "rawSql": "SELECT 1" }] },
    { "id": 4, "type": "timeseries", "title": "Ohne Zuordnung", "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "datasource": { "type": "prometheus", "uid": "prom" }, "targets": [{ "refId": "A", "expr": "up" }] },
    { "id": 5, "type": "row", "title": "Details", "collapsed": true, "gridPos": { "x": 0, "y": 16, "w": 24, "h": 1 },
      "panels": [
        { "id": 6, "type": "table", "title": "Alle Werte", "gridPos": { "x": 0, "y": 17, "w": 24, "h": 9 },
          "datasource": { "type": "sqlite", "uid": "${DS_LAGER}" },
          "targets": [{ "refId": "A", "rawSql": "SELECT host, v FROM m" }],
          "fieldConfig": { "defaults": { "mappings": [ { "type": "value", "options": { "1": { "text": "an" } } } ] } } },
        { "id": 7, "type": "text", "title": "Hinweis", "gridPos": { "x": 0, "y": 26, "w": 12, "h": 3 },
          "options": { "mode": "html", "content": "<b>Lager</b> wird stündlich gezählt." } },
        { "id": 8, "type": "dashlist", "title": "Weitere", "gridPos": { "x": 12, "y": 26, "w": 12, "h": 3 } }
      ] },
    { "id": 9, "type": "timeseries", "title": "Library", "gridPos": { "x": 0, "y": 30, "w": 12, "h": 6 },
      "libraryPanel": { "uid": "lib-1", "name": "Shared" } }
  ]
}
