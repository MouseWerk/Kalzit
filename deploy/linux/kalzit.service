# Kalzit as a systemd service, installed by the deb and rpm packages
# (docs/guide/installation.md, "Debian, Ubuntu, Fedora, RHEL"). Change it with
# `systemctl edit kalzit`, not here: the package replaces this file on every update.

[Unit]
Description=Kalzit, a self-hosted platform to visualize and analyze data
Documentation=https://github.com/MouseWerk/Kalzit/blob/main/docs/guide/installation.md
Wants=network-online.target
After=network-online.target

[Service]
Type=exec
User=kalzit
Group=kalzit
# The configuration named explicitly: no kalzit.toml in a working directory is ever read.
ExecStart=/usr/bin/kalzit --config /etc/kalzit/kalzit.toml serve
WorkingDirectory=/
Restart=on-failure
RestartSec=5s
TimeoutStopSec=30s
UMask=0077
LimitNOFILE=65536

# The secrets key (and optionally the database URL) from the system credential store:
# /etc/credstore.encrypted/kalzit-secrets-key (written by the package with systemd-creds) or
# /etc/credstore/kalzit-secrets-key. Without one, Kalzit keeps a key file in the data directory
# and warns.
ImportCredential=kalzit-secrets-key
ImportCredential=kalzit-database-url

# Ports below 1024 (80 and 443 for HTTPS with ACME) without root. Plugins do not inherit it: the
# sandbox clears the ambient set and drops the bounding set before a plugin starts
# (`kalzit sandbox-check` prints the capabilities a plugin gets).
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Hardening. The plugin sandbox (docs/ARCHITECTURE.md, "Sandbox") still needs user, IPC and
# network namespaces, Landlock and seccomp; `kalzit sandbox-check` shows what plugins get. Where
# AppArmor restricts user namespaces (Ubuntu 23.10 and later), the deb's profile
# /etc/apparmor.d/kalzit allows them for /usr/bin/kalzit.
NoNewPrivileges=yes
ProtectSystem=strict
ReadWritePaths=/var/lib/kalzit
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
RemoveIPC=yes
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6 AF_NETLINK
RestrictNamespaces=~cgroup mnt pid uts
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=landlock_create_ruleset landlock_add_rule landlock_restrict_self setsid
SystemCallErrorNumber=EPERM

[Install]
WantedBy=multi-user.target
