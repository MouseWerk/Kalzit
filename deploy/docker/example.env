# Copy to .env next to the compose file and adjust. .env is not checked in.

# Image and version: a release such as 0.2.0, or latest.
KALZIT_IMAGE=ghcr.io/mousewerk/kalzit
KALZIT_VERSION=latest

# The port on this machine that serves Kalzit.
KALZIT_PORT=3000

# compose.postgres.yaml only: the password of the database user kalzit. Use letters and digits
# only (it is part of a URL), for example the output of `openssl rand -hex 24`.
KALZIT_DB_PASSWORD=change-me
