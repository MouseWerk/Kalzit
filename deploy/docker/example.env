# Copy to .env next to the compose file and adjust. .env is not checked in. Passwords and keys
# do not belong here: they are Docker secrets in ./secrets (see the compose files).

# Image and version: a release such as 0.2.0, or latest.
KALZIT_IMAGE=ghcr.io/mousewerk/kalzit
KALZIT_VERSION=latest

# The port on this machine that serves Kalzit.
KALZIT_PORT=3000
