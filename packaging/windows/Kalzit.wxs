<?xml version="1.0" encoding="utf-8"?>
<!--
  The Kalzit installer for Windows (WiX v5), built by build.ps1. Installation guide:
  docs/guide/installation.md, "Windows"; design: docs/ARCHITECTURE.md, "Running as a service".

  The package installs kalzit.exe into the program folder and the Windows service "Kalzit" (virtual
  account NT SERVICE\Kalzit). Everything else is Kalzit's own step `kalzit service configure`,
  which also backs `kalzit service install`: the configuration file, the data folder and its access
  list, the certificate, the program folder's access list, the service's privileges, the recovery
  actions and the firewall rule; it refuses folders someone else could have prepared. Before the
  program goes, `kalzit service cleanup` removes the firewall rule and, on request, the data.

  Both steps run as LocalSystem from the package's own copy of kalzit.exe (the Binary table,
  which msiexec unpacks into its protected folder), never from the installed program, which the
  service account may change with SELFUPDATE=1. They run only at the first installation and at
  upgrades, never at a repair: the settings are read once. Errors go to the event log. Values are
  quoted with a space before the closing quote ("[DATADIR] "), so a folder ending in a backslash
  cannot escape the quote; Kalzit trims the space, and a quote in a setting stops the
  installation (launch condition) before anything runs.

  Settings (wizard or msiexec properties, see the guide): PORT, DATADIR, HTTPS (off, self-signed,
  certificate), HTTPSPORT, CERTFILE, KEYFILE, FIREWALL, SELFUPDATE; REMOVEDATA when uninstalling.
  An existing %ProgramData%\Kalzit\kalzit.toml is kept, so an upgrade keeps its settings.

  Texts: Kalzit.en-US.wxl and Kalzit.de-DE.wxl. build.ps1 builds the package per language with the
  same product code and stores German inside the English package as a language transform
  (language.ps1), which Windows applies on a German Windows.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="Kalzit"
      Manufacturer="MouseWerk"
      Version="$(Version)"
      ProductCode="$(ProductCode)"
      UpgradeCode="1D4828C2-1200-4926-BC6E-4959850AE762"
      Scope="perMachine"
      Compressed="yes"
      Language="!(loc.KalzitLanguage)">
    <SummaryInformation Description="Kalzit $(Version): visualize and analyze your data" />

    <!-- The previous version goes completely before the new one is installed: kalzit.exe may
         have been replaced by Kalzit's own updater since, and its files and service are put in
         place fresh. The configuration and the data are not part of the package and stay.
         IgnoreLanguage: the German transform changes the product language, and an upgrade in
         one language must still find (and a downgrade still be refused by) any earlier one. -->
    <MajorUpgrade Schedule="afterInstallValidate" IgnoreLanguage="yes" DowngradeErrorMessage="!(loc.KalzitDowngrade)" />
    <MediaTemplate EmbedCab="yes" />

    <Property Id="ARPURLINFOABOUT" Value="https://github.com/MouseWerk/Kalzit" />
    <Property Id="ARPHELPLINK" Value="https://github.com/MouseWerk/Kalzit/blob/main/docs/guide/installation.md" />
    <Property Id="ARPNOMODIFY" Value="1" />
    <!-- The service is stopped by the package (ServiceControl), not through the Restart Manager. -->
    <Property Id="MSIRESTARTMANAGERCONTROL" Value="Disable" />

    <!-- Settings; each can be set on the msiexec command line. -->
    <Property Id="PORT" Value="3000" Secure="yes" />
    <Property Id="HTTPS" Value="off" Secure="yes" />
    <Property Id="HTTPSPORT" Value="3443" Secure="yes" />
    <Property Id="SELFUPDATE" Value="0" Secure="yes" />
    <Property Id="DATADIR" Secure="yes" />
    <Property Id="CERTFILE" Secure="yes" />
    <Property Id="KEYFILE" Secure="yes" />
    <Property Id="FIREWALL" Secure="yes" />
    <Property Id="REMOVEDATA" Secure="yes" />
    <SetProperty Id="DATADIR" Value="[CommonAppDataFolder]Kalzit\data" Before="AppSearch" Sequence="both" Condition="NOT DATADIR" />

    <!-- No setting may contain a quote: it would end the quoted value on Kalzit's command line. -->
    <Property Id="KALZITQUOTE" Value="&quot;" />
    <Launch
        Condition="Installed OR NOT (DATADIR &gt;&lt; KALZITQUOTE OR CERTFILE &gt;&lt; KALZITQUOTE OR KEYFILE &gt;&lt; KALZITQUOTE OR PORT &gt;&lt; KALZITQUOTE OR HTTPS &gt;&lt; KALZITQUOTE OR HTTPSPORT &gt;&lt; KALZITQUOTE OR FIREWALL &gt;&lt; KALZITQUOTE OR SELFUPDATE &gt;&lt; KALZITQUOTE OR INSTALLFOLDER &gt;&lt; KALZITQUOTE)"
        Message="!(loc.KalzitQuoteInSetting)" />

    <!-- An existing configuration is kept; the wizard then skips the settings. -->
    <Property Id="CONFIGEXISTS">
      <DirectorySearch Id="KalzitConfigFolder" Path="[CommonAppDataFolder]Kalzit" Depth="0">
        <FileSearch Id="KalzitConfigFile" Name="kalzit.toml" />
      </DirectorySearch>
    </Property>

    <!-- The program folder of an earlier installation. -->
    <Property Id="INSTALLFOLDER">
      <RegistrySearch Id="KalzitInstallFolder" Root="HKLM" Key="Software\MouseWerk\Kalzit" Name="InstallFolder" Type="raw" />
    </Property>

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Kalzit" />
    </StandardDirectory>

    <ComponentGroup Id="KalzitProgram" Directory="INSTALLFOLDER">
      <Component Id="KalzitExe" Bitness="always64">
        <File Id="KalzitExe" Name="kalzit.exe" Source="$(ExePath)" KeyPath="yes" />
        <ServiceInstall
            Id="KalzitService"
            Name="Kalzit"
            DisplayName="Kalzit"
            Description="Kalzit: visualize and analyze your data."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="NT SERVICE\Kalzit"
            Arguments="service run --config &quot;[CommonAppDataFolder]Kalzit\kalzit.toml&quot;"
            Vital="yes" />
        <ServiceControl Id="KalzitServiceControl" Name="Kalzit" Start="install" Stop="both" Remove="uninstall" Wait="yes" />
        <!-- What Kalzit's updater leaves next to the program: binaries moved aside while they
             still ran, and a copy from an interrupted update. -->
        <RemoveFile Id="KalzitOldBinaries" Name=".kalzit.exe.old-*" On="uninstall" />
        <RemoveFile Id="KalzitNewBinary" Name=".kalzit.new.exe" On="uninstall" />
      </Component>
      <Component Id="KalzitLicense" Bitness="always64">
        <File Id="KalzitLicense" Name="LICENSE.txt" Source="$(LicensePath)" KeyPath="yes" />
      </Component>
      <Component Id="KalzitRegistration" Bitness="always64">
        <RegistryValue Root="HKLM" Key="Software\MouseWerk\Kalzit" Name="InstallFolder" Type="string" Value="[INSTALLFOLDER]" KeyPath="yes" />
        <!-- The event log source "Kalzit": the general message file shows Kalzit's text as it is. -->
        <RegistryValue
            Root="HKLM"
            Key="SYSTEM\CurrentControlSet\Services\EventLog\Application\Kalzit"
            Name="EventMessageFile"
            Type="expandable"
            Value="%SystemRoot%\Microsoft.NET\Framework64\v4.0.30319\EventLogMessages.dll" />
      </Component>
    </ComponentGroup>

    <Feature Id="Kalzit" Title="Kalzit" Level="1" AllowAbsent="no">
      <ComponentGroupRef Id="KalzitProgram" />
    </Feature>

    <!-- Kalzit's own steps run as LocalSystem from the package's copy of kalzit.exe: configure
         once the service exists and before it starts (its program option names the installed file),
         clean up before the program is removed (not when an upgrade removes the previous
         version). Errors go to the event log. -->
    <Binary Id="KalzitSetup" SourceFile="$(ExePath)" />
    <CustomAction
        Id="KalzitConfigure"
        BinaryRef="KalzitSetup"
        ExeCommand="service configure --program &quot;[#KalzitExe] &quot; --config &quot;[CommonAppDataFolder]Kalzit\kalzit.toml&quot; --data-dir &quot;[DATADIR] &quot; --port &quot;[PORT]&quot; --https &quot;[HTTPS]&quot; --https-port &quot;[HTTPSPORT]&quot; --cert-file &quot;[CERTFILE] &quot; --key-file &quot;[KEYFILE] &quot; --open-firewall &quot;[FIREWALL]&quot; --self-update &quot;[SELFUPDATE]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="check" />
    <CustomAction
        Id="KalzitCleanup"
        BinaryRef="KalzitSetup"
        ExeCommand="service cleanup --config &quot;[CommonAppDataFolder]Kalzit\kalzit.toml&quot; --remove-data &quot;[REMOVEDATA]&quot;"
        Execute="deferred"
        Impersonate="no"
        Return="ignore" />
    <InstallExecuteSequence>
      <Custom Action="KalzitConfigure" After="InstallServices" Condition="NOT Installed AND NOT REMOVE~=&quot;ALL&quot;" />
      <Custom Action="KalzitCleanup" Before="RemoveFiles" Condition="REMOVE~=&quot;ALL&quot; AND NOT UPGRADINGPRODUCTCODE" />
    </InstallExecuteSequence>

    <UIRef Id="KalzitUI" />
  </Package>
</Wix>
