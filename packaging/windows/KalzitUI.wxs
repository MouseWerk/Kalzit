<?xml version="1.0" encoding="utf-8"?>
<!--
  The installer's wizard: Welcome, program folder, Kalzit's settings (port, data folder, HTTPS,
  firewall; skipped when a kalzit.toml exists), ready, progress, done. Removing asks whether the
  data goes too. Built on the WixUI dialogs of WixToolset.UI.wixext (the InstallDir set without
  the license page: Kalzit's license, the AGPL, needs no acceptance to install).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Fragment>
    <UI Id="KalzitUI">
      <TextStyle Id="WixUI_Font_Normal" FaceName="Tahoma" Size="8" />
      <TextStyle Id="WixUI_Font_Bigger" FaceName="Tahoma" Size="12" />
      <TextStyle Id="WixUI_Font_Title" FaceName="Tahoma" Size="9" Bold="yes" />
      <Property Id="DefaultUIFont" Value="WixUI_Font_Normal" />
      <Property Id="WIXUI_INSTALLDIR" Value="INSTALLFOLDER" />

      <DialogRef Id="BrowseDlg" />
      <DialogRef Id="DiskCostDlg" />
      <DialogRef Id="ErrorDlg" />
      <DialogRef Id="FatalError" />
      <DialogRef Id="FilesInUse" />
      <DialogRef Id="MsiRMFilesInUse" />
      <DialogRef Id="PrepareDlg" />
      <DialogRef Id="ProgressDlg" />
      <DialogRef Id="ResumeDlg" />
      <DialogRef Id="UserExit" />

      <Publish Dialog="BrowseDlg" Control="OK" Event="DoAction" Value="WixUIValidatePath_X64" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="BrowseDlg" Control="OK" Event="SpawnDialog" Value="InvalidDirDlg" Order="4" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="ExitDialog" Control="Finish" Event="EndDialog" Value="Return" Order="999" />

      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="InstallDirDlg" Condition="NOT Installed" />
      <Publish Dialog="WelcomeDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Condition="Installed AND PATCH" />

      <Publish Dialog="InstallDirDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SetTargetPath" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="DoAction" Value="WixUIValidatePath_X64" Order="2" Condition="NOT WIXUI_DONTVALIDATEPATH" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="SpawnDialog" Value="InvalidDirDlg" Order="3" Condition="NOT WIXUI_DONTVALIDATEPATH AND WIXUI_INSTALLDIR_VALID&lt;&gt;&quot;1&quot;" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="KalzitSettingsDlg" Order="4" Condition="(WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;) AND NOT CONFIGEXISTS" />
      <Publish Dialog="InstallDirDlg" Control="Next" Event="NewDialog" Value="VerifyReadyDlg" Order="5" Condition="(WIXUI_DONTVALIDATEPATH OR WIXUI_INSTALLDIR_VALID=&quot;1&quot;) AND CONFIGEXISTS" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Property="_BrowseProperty" Value="[WIXUI_INSTALLDIR]" Order="1" />
      <Publish Dialog="InstallDirDlg" Control="ChangeFolder" Event="SpawnDialog" Value="BrowseDlg" Order="2" />

      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="KalzitSettingsDlg" Order="1" Condition="NOT Installed AND NOT CONFIGEXISTS" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="InstallDirDlg" Order="1" Condition="NOT Installed AND CONFIGEXISTS" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="KalzitRemoveDataDlg" Order="2" Condition="Installed AND WixUI_InstallMode=&quot;Remove&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="MaintenanceTypeDlg" Order="2" Condition="Installed AND NOT PATCH AND WixUI_InstallMode&lt;&gt;&quot;Remove&quot;" />
      <Publish Dialog="VerifyReadyDlg" Control="Back" Event="NewDialog" Value="WelcomeDlg" Order="2" Condition="Installed AND PATCH" />

      <Publish Dialog="MaintenanceWelcomeDlg" Control="Next" Event="NewDialog" Value="MaintenanceTypeDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RepairButton" Event="NewDialog" Value="VerifyReadyDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="RemoveButton" Event="NewDialog" Value="KalzitRemoveDataDlg" />
      <Publish Dialog="MaintenanceTypeDlg" Control="Back" Event="NewDialog" Value="MaintenanceWelcomeDlg" />

      <Dialog Id="KalzitSettingsDlg" Width="370" Height="270" Title="!(loc.InstallDirDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.InstallDirDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Server settings" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="Where Kalzit listens and keeps its data. You can change this later in kalzit.toml." />

        <Control Id="PortLabel" Type="Text" X="20" Y="56" Width="100" Height="10" Text="HTTP &amp;port:" />
        <Control Id="Port" Type="Edit" X="125" Y="53" Width="50" Height="15" Property="PORT" Text="{5}" />

        <Control Id="DataLabel" Type="Text" X="20" Y="76" Width="100" Height="10" Text="&amp;Data folder:" />
        <Control Id="Data" Type="Edit" X="125" Y="73" Width="225" Height="15" Property="DATADIR" Text="{260}" />
        <Control Id="DataNote" Type="Text" X="125" Y="90" Width="225" Height="10" NoPrefix="yes" Text="Only Administrators and the service account get access." />

        <Control Id="HttpsLabel" Type="Text" X="20" Y="106" Width="100" Height="10" Text="HTTPS:" />
        <Control Id="Https" Type="RadioButtonGroup" X="125" Y="104" Width="225" Height="42" Property="HTTPS">
          <RadioButtonGroup Property="HTTPS">
            <RadioButton Value="off" X="0" Y="0" Width="225" Height="13" Text="&amp;Off (HTTP only)" />
            <RadioButton Value="self-signed" X="0" Y="14" Width="225" Height="13" Text="&amp;Self-signed certificate for this computer" />
            <RadioButton Value="certificate" X="0" Y="28" Width="225" Height="13" Text="&amp;Existing certificate (PEM files)" />
          </RadioButtonGroup>
        </Control>

        <Control Id="HttpsPortLabel" Type="Text" X="20" Y="152" Width="100" Height="10" Text="HTTPS p&amp;ort:" />
        <Control Id="HttpsPort" Type="Edit" X="125" Y="149" Width="50" Height="15" Property="HTTPSPORT" Text="{5}" DisableCondition="HTTPS = &quot;off&quot;" EnableCondition="HTTPS &lt;&gt; &quot;off&quot;" />
        <Control Id="CertLabel" Type="Text" X="20" Y="172" Width="100" Height="10" Text="&amp;Certificate file:" />
        <Control Id="Cert" Type="Edit" X="125" Y="169" Width="225" Height="15" Property="CERTFILE" Text="{260}" DisableCondition="HTTPS &lt;&gt; &quot;certificate&quot;" EnableCondition="HTTPS = &quot;certificate&quot;" />
        <Control Id="KeyLabel" Type="Text" X="20" Y="192" Width="100" Height="10" Text="&amp;Key file:" />
        <Control Id="Key" Type="Edit" X="125" Y="189" Width="225" Height="15" Property="KEYFILE" Text="{260}" DisableCondition="HTTPS &lt;&gt; &quot;certificate&quot;" EnableCondition="HTTPS = &quot;certificate&quot;" />

        <Control Id="Firewall" Type="CheckBox" X="20" Y="212" Width="330" Height="15" Property="FIREWALL" CheckBoxValue="1" Text="Open the port(s) in Windows Defender &amp;Firewall" />
        <Control Id="CertMissing" Type="Text" X="20" Y="240" Width="150" Height="20" NoPrefix="yes" Text="Enter the certificate and key file." HideCondition="HTTPS &lt;&gt; &quot;certificate&quot; OR (CERTFILE AND KEYFILE)" ShowCondition="HTTPS = &quot;certificate&quot; AND (NOT CERTFILE OR NOT KEYFILE)" />

        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="InstallDirDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" Condition="PORT AND DATADIR AND (HTTPS &lt;&gt; &quot;certificate&quot; OR (CERTFILE AND KEYFILE))" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>

      <Dialog Id="KalzitRemoveDataDlg" Width="370" Height="270" Title="!(loc.MaintenanceTypeDlg_Title)">
        <Control Id="BannerBitmap" Type="Bitmap" X="0" Y="0" Width="370" Height="44" TabSkip="no" Text="!(loc.MaintenanceTypeDlgBannerBitmap)" />
        <Control Id="BannerLine" Type="Line" X="0" Y="44" Width="370" Height="0" />
        <Control Id="BottomLine" Type="Line" X="0" Y="234" Width="370" Height="0" />
        <Control Id="Title" Type="Text" X="15" Y="6" Width="200" Height="15" Transparent="yes" NoPrefix="yes" Text="{\WixUI_Font_Title}Remove Kalzit" />
        <Control Id="Description" Type="Text" X="25" Y="23" Width="280" Height="15" Transparent="yes" NoPrefix="yes" Text="The program and the service go. Your data stays unless you choose otherwise." />
        <Control Id="Text" Type="Text" X="20" Y="60" Width="330" Height="50" NoPrefix="yes" Text="Kalzit keeps its database, dashboards, data sources, logs and the key for stored passwords in its data folder, named in [CommonAppDataFolder]Kalzit\kalzit.toml. Kept, they are used again when you install Kalzit later." />
        <Control Id="RemoveData" Type="CheckBox" X="20" Y="120" Width="330" Height="15" Property="REMOVEDATA" CheckBoxValue="1" Text="Also &amp;remove the data folder and the configuration (cannot be undone)" />
        <Control Id="Back" Type="PushButton" X="180" Y="243" Width="56" Height="17" Text="!(loc.WixUIBack)">
          <Publish Event="NewDialog" Value="MaintenanceTypeDlg" />
        </Control>
        <Control Id="Next" Type="PushButton" X="236" Y="243" Width="56" Height="17" Default="yes" Text="!(loc.WixUINext)">
          <Publish Event="NewDialog" Value="VerifyReadyDlg" />
        </Control>
        <Control Id="Cancel" Type="PushButton" X="304" Y="243" Width="56" Height="17" Cancel="yes" Text="!(loc.WixUICancel)">
          <Publish Event="SpawnDialog" Value="CancelDlg" />
        </Control>
      </Dialog>
    </UI>

    <UIRef Id="WixUI_Common" />

    <!-- The last page says where Kalzit runs and how to sign in the first time. -->
    <SetProperty
        Id="WIXUI_EXITDIALOGOPTIONALTEXT"
        Action="KalzitExitTextNew"
        Value="Kalzit runs as the Windows service &quot;Kalzit&quot;. Open http://localhost:[PORT] in a browser. The setup code for the first sign-in is in [DATADIR]\setup-token.txt, which only administrators can open (for example Get-Content in PowerShell opened with Run as administrator)."
        After="CostFinalize"
        Sequence="ui"
        Condition="NOT Installed AND NOT CONFIGEXISTS" />
    <SetProperty
        Id="WIXUI_EXITDIALOGOPTIONALTEXT"
        Action="KalzitExitTextKept"
        Value="Kalzit runs as the Windows service &quot;Kalzit&quot; with the settings of its existing kalzit.toml."
        After="CostFinalize"
        Sequence="ui"
        Condition="NOT Installed AND CONFIGEXISTS" />
  </Fragment>
</Wix>
