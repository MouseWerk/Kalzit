{
  "name": "kalzit-devkit",
  "private": true,
  "version": "0.0.0",
  "description": "Developer toolkit for working on Kalzit: instances, screen capture, visual diff, UI checks, CI and merge helpers. Never shipped with the product.",
  "license": "AGPL-3.0-only",
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "bin": {
    "kalzit-devkit": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "biome lint --error-on-warnings .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "check": "biome check --error-on-warnings .",
    "test": "vitest run",
    "test:smoke": "vitest run --config vitest.smoke.config.ts"
  },
  "dependencies": {
    "@axe-core/playwright": "4.14.0",
    "@modelcontextprotocol/sdk": "1.32.2",
    "pixelmatch": "8.0.0",
    "playwright": "1.64.1",
    "pngjs": "7.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.2",
    "@types/node": "26.6.5",
    "@types/pngjs": "6.0.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5"
  }
}
